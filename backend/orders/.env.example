# --- Servicio ---
SERVICE_NAME=orders
HOST=0.0.0.0
PORT=8003
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Base de datos propia (orders_db) ---
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@127.0.0.1:5432/orders

# --- Seguridad (mismos valores que en el resto de servicios) ---
JWT_SECRET=cambia-este-secreto
INTERNAL_API_KEY=cambia-esta-clave-interna

# --- Servicios con los que se comunica ---
EVENTS_URL=http://127.0.0.1:8002
PAYMENTS_URL=http://127.0.0.1:8004
TICKETS_URL=http://127.0.0.1:8005
NOTIFICATIONS_URL=http://127.0.0.1:8006

# --- Tiempos máximos de espera (segundos) ---
HTTP_TIMEOUT_SECONDS=5
PAYMENTS_TIMEOUT_SECONDS=25
TICKETS_TIMEOUT_SECONDS=20

# --- URL pública del gateway (Libélula devuelve aquí al cliente) y de la web ---
PUBLIC_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Reglas de negocio ---
MAX_TICKETS_PER_ORDER=6
CURRENCY=BOB
PENDING_EXPIRY_MINUTES=30
