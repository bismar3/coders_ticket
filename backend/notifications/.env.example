# --- Servicio (interno: no se expone en Nginx) ---
SERVICE_NAME=notifications
HOST=0.0.0.0
PORT=8006
LOG_LEVEL=INFO

# --- Clave compartida con los servicios que envían correos ---
INTERNAL_API_KEY=cambia-esta-clave-interna

# --- SMTP ---
# v1 (por defecto): Mailpit atrapa TODOS los correos en http://localhost:8025 (no envía nada real).
# Para que lleguen a la bandeja real del comprador con Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_STARTTLS=true
#   SMTP_USER=tucuenta@gmail.com  SMTP_PASSWORD=<contraseña de aplicación de 16 letras>
#   MAIL_FROM=coders_tick <tucuenta@gmail.com>
#   (la contraseña de aplicación se crea en myaccount.google.com > Seguridad > Verificación en 2 pasos)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=5
MAIL_FROM=coders_tick <no-reply@coderstick.bo>

# --- Enlaces dentro de los correos ---
FRONTEND_URL=http://localhost:5173
TIMEZONE=America/La_Paz
