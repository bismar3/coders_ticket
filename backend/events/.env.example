# --- Servicio ---
SERVICE_NAME=events
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Base de datos propia (events_db) ---
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@127.0.0.1:5432/events

# --- Seguridad (mismos valores que en el resto de servicios) ---
JWT_SECRET=cambia-este-secreto
INTERNAL_API_KEY=cambia-esta-clave-interna

# --- Imágenes de los eventos ---
MEDIA_DIR=./media
MEDIA_PUBLIC_URL=/api/events/media
MAX_IMAGE_MB=5
