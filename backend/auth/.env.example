# --- Servicio ---
SERVICE_NAME=auth
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Base de datos propia (auth_db) ---
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@127.0.0.1:5432/auth

# --- Tokens (el mismo JWT_SECRET en todos los servicios que validan tokens) ---
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_MINUTES=720

# --- Correo de bienvenida opcional (notifications) ---
NOTIFICATIONS_URL=http://127.0.0.1:8006
INTERNAL_API_KEY=cambia-esta-clave-interna
HTTP_TIMEOUT_SECONDS=3
