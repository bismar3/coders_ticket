# --- Servicio (interno: no se expone en Nginx) ---
SERVICE_NAME=payments
HOST=0.0.0.0
PORT=8004
LOG_LEVEL=INFO

# --- Base de datos propia (payments_db) ---
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@127.0.0.1:5432/payments

# --- Clave compartida con orders (único servicio que puede llamar a payments) ---
INTERNAL_API_KEY=cambia-esta-clave-interna

# --- Libélula (sandbox) ---
LIBELULA_APPKEY=tu-appkey-de-pruebas
LIBELULA_REGISTER_URL=https://api.libelula.bo/rest/deuda/registrar
LIBELULA_QUERY_URL=https://api.libelula.bo/rest/deuda/consultar_deudas/por_identificador
LIBELULA_IDENTIFIER_PREFIX=coderstick-
LIBELULA_TIMEOUT_SECONDS=15

# --- Simulador interno: tarjetas que terminan en este sufijo se rechazan ---
SIMULATED_REJECT_SUFFIX=0000
